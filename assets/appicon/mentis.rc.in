// Generated into the build folder by CMakeLists.txt (configure_file): the icon and the version
// information of Mentis.exe. SignPath checks the product name and version (FEAT-090).
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/appicon/mentis.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Mentis"
            VALUE "FileDescription", "Mentis"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Mentis"
            VALUE "LegalCopyright", "GNU AGPL-3.0"
            VALUE "OriginalFilename", "Mentis.exe"
            VALUE "ProductName", "Mentis"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
