<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the ZIP that release.yml uploads with the Inno Setup
     installer, whose name carries the version. ProductName "Mentis" comes from
     VersionInfoProductName in installer/mentis.iss. Reference:
     https://docs.signpath.io/artifact-configuration/reference -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set product-name="Mentis">
      <include path="Mentis-*-setup-x64.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
