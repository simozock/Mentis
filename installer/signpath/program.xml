<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "program": the ZIP that release.yml uploads with the program's
     own binaries. Both files carry ProductName "Mentis" (assets/appicon/mentis.rc.in,
     third_party/jkqtmathtext/mentismathtext.rc.in): SignPath refuses a file whose metadata differs.
     Reference: https://docs.signpath.io/artifact-configuration/reference -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set product-name="Mentis">
      <include path="Mentis.exe" />
      <include path="MentisMathText.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
